# "." nested object), configuration-line quoting, the JSON types the value
# matcher dispatches on, claim names that contain a separator, and regex
# syntax for the per-request PCRE.
":"
"~"
"."
"\x0a"
" "
"\""
"'"
"iss:"
"sub:"
"groups:"
"scope~"
"email~"
"address.country:"
"realm_access.roles:"
"https://idp.example.com"
"https://example.com/claims/role"
"\"iss:https\":"
"true"
"false"
"null"
"42"
"4.5"
"{\"sub\":\"alice\"}"
"{\"groups\":[\"admin\"]}"
"{\"address\":{\"country\":\"NL\"}}"
"[]"
"{}"
"^"
"$"
".*"
"\\."
"(^| )"
"( |$)"
"[a-z]+"
